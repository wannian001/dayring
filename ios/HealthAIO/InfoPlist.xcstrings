    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health AIO reads sleep, steps, heart rate, VO2 max (cardio fitness), weight, food and workouts and sends them only to your own computer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health AIO 读取睡眠、步数、心率、最大摄氧量（心肺能力）、体重、饮食和体能训练，只发送到你自己的电脑。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health AIO talks to healthaio on your own computer over your home network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Health AIO 通过家里的网络和你电脑上的 healthaio 通信。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
