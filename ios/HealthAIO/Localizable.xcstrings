    "When": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间"
          }
        }
      }
    },
    "Workouts": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体能训练"
          }
        }
      }
    },
    "Your computer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的电脑"
          }
        }
      }
    },
    "Your computer already has a different package with this id.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上已经有一个编号相同、内容不同的数据包。"
          }
        }
      }
    },
    "Your computer answered with an error (HTTP %lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑返回了错误（HTTP %lld）。"
          }
        }
      }
    },
    "Your computer can sign the app again and install it on this phone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的电脑可以重新签名这个 App，并安装到这台手机上。"
          }
        }
      }
    },
    "Your computer cannot find the app's project (the ios folder of the Health AIO repository). Install healthaio from a copy of the repository.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑找不到这个 App 的工程（Health AIO 仓库里的 ios 文件夹）。请用仓库的副本安装 healthaio。"
          }
        }
      }
    },
    "Your computer cannot renew the app right now.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑现在没法续签这个 App。"
          }
        }
      }
    },
    "Your computer did not accept this phone. Pair again in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑没有接受这台手机。请在“设置”里重新配对。"
          }
        }
      }
    },
    "Your computer did not let this phone in": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑没有让这台手机访问"
          }
        }
      }
    },
    "Your computer does not know which Apple account signs the app. Copy ios/Local.example.xcconfig to ios/Local.xcconfig and put your bundle id and Team ID in it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑不知道用哪个 Apple 账号签名。请把 ios/Local.example.xcconfig 复制为 ios/Local.xcconfig，并填上你的 bundle id 和 Team ID。"
          }
        }
      }
    },
    "Your computer has never received it. Tap Check and retry to send the same package again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑从没收到过它。点“检查并重试”会把同一个数据包再发一次。"
          }
        }
      }
    },
    "Your computer has no Xcode, so it cannot sign the app. Install Xcode from the Mac App Store and open it once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上没有 Xcode，没法签名。请从 Mac App Store 安装 Xcode 并打开一次。"
          }
        }
      }
    },
    "Your computer is building and installing the app. iOS will close Health AIO once when the new copy is installed; open it again afterwards.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑正在编译并安装 App。新版本装好时 iOS 会关闭一次 Health AIO，之后重新打开即可。"
          }
        }
      }
    },
    "Your computer refused this package. Discard it; the next read makes a new one.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑拒绝了这个数据包。请丢弃它，下次读取会生成新的。"
          }
        }
      }
    },
    "Your computer runs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑上的版本"
          }
        }
      }
    },
    "Your computer sent an answer this app can't read. Update healthaio on the computer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑返回的内容这个 App 读不懂。请更新电脑上的 healthaio。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
