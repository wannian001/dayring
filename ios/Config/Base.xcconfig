// Settings shared by the app and its tests. Your own bundle id and team go in ../Local.xcconfig
// (copy ../Local.example.xcconfig); that file stays out of git.

HEALTHAIO_BUNDLE_ID = org.example.healthaio
HEALTHAIO_TEAM =

#include? "../Local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(HEALTHAIO_BUNDLE_ID)
DEVELOPMENT_TEAM = $(HEALTHAIO_TEAM)
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.3.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
